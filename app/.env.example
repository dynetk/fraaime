# LOCAL ONLY: no Google session; binds to loopback. Never enabled on Vercel.
FRAAIME_LOCAL_MODE=1
FRAAIME_LOCAL_EMAIL=developer@localhost
# Hosted mode: FRAAIME_LOCAL_MODE=0, all values below configured server-side.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Set verified current USD/token pricing before enabling paid processing.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
JOB_BUDGET_USD=10
MONTHLY_BUDGET_USD=100
MAX_ACTIVE_JOBS=2
MAX_UPLOAD_MB=120
MAX_PDF_PAGES=150
MAX_AI_PAGES=30
ADMIN_EMAILS=
# Worker has the same strong random token; never NEXT_PUBLIC.
PDF_WORKER_URL=http://127.0.0.1:5191
PDF_WORKER_TOKEN=
APP_ORIGIN=http://127.0.0.1:5190
