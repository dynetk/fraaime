# LOCAL ONLY: no Google session; binds to loopback. Never enabled on Vercel.
FRAAIME_LOCAL_MODE=1
FRAAIME_LOCAL_EMAIL=developer@localhost
# Hosted mode: FRAAIME_LOCAL_MODE=0, all values below configured server-side.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=medium
# Experimental joint-sheet shell, Sol medium; OFF until plan accuracy review.
FRAAIME_SHELL_FUSION=0
# Standard processing, USD per million tokens, verified 2026-11-09.
# Revalidate when changing the model. Budget accounting conservatively ignores cache discounts.
OPENAI_INPUT_USD_PER_MILLION=2
OPENAI_OUTPUT_USD_PER_MILLION=10
JOB_BUDGET_USD=10
MONTHLY_BUDGET_USD=100
MAX_ACTIVE_JOBS=2
MAX_UPLOAD_MB=120
MAX_PDF_PAGES=150
MAX_AI_PAGES=30
ADMIN_EMAILS=
# Worker has the same strong random token; never NEXT_PUBLIC.
PDF_WORKER_URL=http://127.0.0.1:5191
PDF_WORKER_TOKEN=
APP_ORIGIN=http://127.0.0.1:5190

# Experimental second pass; requires FRAAIME_SHELL_FUSION=1. Keep off in production pending evaluation.
FRAAIME_SHELL_DETAILS=0
